{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://publisher.genii.foundation/schemas/audio-checkpoint.schema.json",
  "title": "GENII Publisher audio checkpoint",
  "description": "Immutable evidence for one remotely verified narration checkpoint. This is author lifecycle evidence, not a browser artifact or an instruction to publish objects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "publicationId",
    "checkpointId",
    "source",
    "pipeline",
    "voice",
    "recordedAt",
    "remoteVerifiedAt",
    "statistics",
    "unitsSha256",
    "units"
  ],
  "properties": {
    "$schema": {
      "const": "https://publisher.genii.foundation/schemas/audio-checkpoint.schema.json"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "publicationId": {
      "$ref": "#/$defs/stableId"
    },
    "checkpointId": {
      "$ref": "#/$defs/opaqueId"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "pipeline": {
      "$ref": "#/$defs/pipeline"
    },
    "voice": {
      "$ref": "#/$defs/voice"
    },
    "recordedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "remoteVerifiedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "statistics": {
      "$ref": "#/$defs/statistics"
    },
    "unitsSha256": {
      "$ref": "#/$defs/sha256Digest"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/unit"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 32
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readerBuildId",
        "sourceRevision",
        "catalogSha256",
        "settingsSha256"
      ],
      "properties": {
        "readerBuildId": {
          "$ref": "#/$defs/sha256Digest"
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[!-~]+$"
        },
        "catalogSha256": {
          "$ref": "#/$defs/sha256Digest"
        },
        "settingsSha256": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 214
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "runId",
        "provider",
        "model"
      ],
      "properties": {
        "adapter": {
          "$ref": "#/$defs/adapter"
        },
        "runId": {
          "$ref": "#/$defs/opaqueId"
        },
        "provider": {
          "$ref": "#/$defs/boundedText"
        },
        "model": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "label": {
          "$ref": "#/$defs/boundedText"
        },
        "referenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "objectKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*/$)[A-Za-z0-9._~!$&'()*+,;=:@%/-]+$"
    },
    "publishedObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectKey",
        "byteSize",
        "sha256"
      ],
      "properties": {
        "objectKey": {
          "$ref": "#/$defs/objectKey"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "sha256": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sectionId",
        "audioVersionId",
        "spokenTextSha256",
        "durationSeconds",
        "exactWordCount",
        "interpolatedWordCount",
        "timingSource",
        "audioFormat",
        "audio",
        "timings"
      ],
      "properties": {
        "sectionId": {
          "$ref": "#/$defs/opaqueId"
        },
        "audioVersionId": {
          "$ref": "#/$defs/opaqueId"
        },
        "spokenTextSha256": {
          "$ref": "#/$defs/sha256Digest"
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 86400
        },
        "exactWordCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "interpolatedWordCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "timingSource": {
          "$ref": "#/$defs/boundedText"
        },
        "audioFormat": {
          "enum": [
            "mp3",
            "opus",
            "wav"
          ]
        },
        "audio": {
          "$ref": "#/$defs/publishedObject"
        },
        "timings": {
          "$ref": "#/$defs/publishedObject"
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitCount",
        "objectCount",
        "durationSeconds",
        "audioBytes",
        "timingsBytes"
      ],
      "properties": {
        "unitCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        },
        "objectCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100000
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4320000000
        },
        "audioBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 214748364800000
        },
        "timingsBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6710886400000
        }
      }
    }
  }
}
