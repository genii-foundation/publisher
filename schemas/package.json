{
  "name": "@genii-foundation/publisher-schema",
  "version": "0.1.0-alpha.0",
  "description": "Framework-neutral source schemas and validators for GENII Publisher.",
  "license": "CPAL-1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "CHANGES.md",
    "LEGAL",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "SOURCE-NOTICE",
    "dist",
    "scripts",
    "src",
    "tsconfig.json",
    "*.schema.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./publication.schema.json": "./publication.schema.json",
    "./work.schema.json": "./work.schema.json",
    "./collection.schema.json": "./collection.schema.json"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ./scripts/build.mjs",
    "prepublishOnly": "node ./scripts/check-release-tag.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genii-foundation/publisher.git",
    "directory": "schemas"
  },
  "homepage": "https://publisher.genii.foundation",
  "bugs": {
    "url": "https://github.com/genii-foundation/publisher/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/semver": "7.7.1",
    "typescript": "7.0.2"
  }
}
