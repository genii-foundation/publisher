{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://publisher.genii.foundation/schemas/updates-envelope.schema.json",
  "title": "GENII Publisher Updates envelope",
  "description": "Validated Updates data bound to one Reader build.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "publicationId", "engineVersion", "buildId", "source", "views"],
  "properties": {
    "$schema": {
      "const": "https://publisher.genii.foundation/schemas/updates-envelope.schema.json"
    },
    "schemaVersion": { "const": "1.0" },
    "publicationId": { "$ref": "./updates-catalog.schema.json#/$defs/stableId" },
    "engineVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "buildId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "catalogPath", "catalogSha256"],
      "properties": {
        "adapter": { "$ref": "./publication.schema.json#/$defs/packageReference" },
        "catalogPath": { "$ref": "./publication.schema.json#/$defs/relativePath" },
        "catalogSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "./updates-catalog.schema.json#/$defs/view" }
    }
  }
}
