{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://publisher.genii.foundation/schemas/reader-envelope.schema.json",
  "title": "GENII Publisher reader envelope",
  "description": "Framework-neutral, deterministic publication data for graphical and non-graphical readers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "publicationId",
    "engineVersion",
    "readerVersion",
    "buildId",
    "source",
    "artifact",
    "audience",
    "textProfile",
    "publication",
    "works",
    "collections",
    "assets",
    "links",
    "routes",
    "statistics"
  ],
  "properties": {
    "$schema": {
      "const": "https://publisher.genii.foundation/schemas/reader-envelope.schema.json"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "publicationId": {
      "$ref": "#/$defs/stableId"
    },
    "engineVersion": {
      "$ref": "#/$defs/exactSemver"
    },
    "readerVersion": {
      "$ref": "#/$defs/exactSemver"
    },
    "buildId": {
      "$ref": "#/$defs/sha256Digest"
    },
    "source": {
      "$ref": "#/$defs/contentSourceIdentity"
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "audience": {
      "enum": [
        "public",
        "preview"
      ]
    },
    "textProfile": {
      "$ref": "#/$defs/textProfile"
    },
    "publication": {
      "$ref": "#/$defs/publication"
    },
    "works": {
      "type": "array",
      "maxItems": 4999,
      "items": {
        "$ref": "#/$defs/work"
      }
    },
    "collections": {
      "type": "array",
      "maxItems": 9997,
      "items": {
        "$ref": "#/$defs/collection"
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "links": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "routes": {
      "$ref": "#/$defs/routes"
    },
    "statistics": {
      "$ref": "#/$defs/statistics"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "contentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "exactSemver": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "routePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "oneOf": [
        {
          "const": "/"
        },
        {
          "type": "string",
          "minLength": 2,
          "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*//)(?!.*(?:%C2%(?:8[0-9A-F]|9[0-9A-F]|A0)|%E1%9A%80|%E2%80%(?:8[0-9A]|A[89F])|%E2%81%9F|%E3%80%80|%EF%BB%BF))(?:[A-Za-z0-9._~!$&'()*+,;=:@/-]|%(?:C[2-9A-F]|D[0-9A-F])%[89AB][0-9A-F]|%E0%[AB][0-9A-F]%[89AB][0-9A-F]|%E(?:[1-C]|[E-F])%[89AB][0-9A-F]%[89AB][0-9A-F]|%ED%[89][0-9A-F]%[89AB][0-9A-F]|%F0%[9AB][0-9A-F]%[89AB][0-9A-F]%[89AB][0-9A-F]|%F[1-3]%[89AB][0-9A-F]%[89AB][0-9A-F]%[89AB][0-9A-F]|%F4%8[0-9A-F]%[89AB][0-9A-F]%[89AB][0-9A-F])+$",
          "description": "A canonical non-root route serialized as ASCII. Non-ASCII Unicode scalar values use uppercase UTF-8 percent encoding; ASCII octets are never percent encoded. Decoded NFC normalization is enforced by semantic validation."
        }
      ]
    },
    "urlFragment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!.*\\s)(?!.*[\\uD800-\\uDFFF])(?:[A-Za-z0-9._~!$&'()*+,;=:@/?-]|%[0-9A-Fa-f]{2}|[^\\u0000-\\u007F])+$"
    },
    "contentAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/routePath"
        },
        "anchor": {
          "$ref": "#/$defs/urlFragment"
        }
      }
    },
    "sectionReaderAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/routePath"
        },
        "anchor": {
          "$ref": "#/$defs/contentId"
        }
      }
    },
    "blockDomId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 513,
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$))[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "description": "A public block DOM identity. A qualified identity may contain a 256-character section content ID, one hyphen, and a 256-character block content ID."
    },
    "blockReaderAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "anchor"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/routePath"
        },
        "anchor": {
          "$ref": "#/$defs/blockDomId"
        }
      }
    },
    "originRelativeAnchoredHref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 4097,
      "pattern": "^(?=[^#]{1,2048}#)(?:/|/(?!/)(?!\\.{1,2}(?:/|#))(?![^#]*\\/\\.{1,2}(?:\\/|#))(?![^#]*//)(?![^#]*(?:%C2%(?:8[0-9A-F]|9[0-9A-F]|A0)|%E1%9A%80|%E2%80%(?:8[0-9A]|A[89F])|%E2%81%9F|%E3%80%80|%EF%BB%BF))(?:[A-Za-z0-9._~!$&'()*+,;=:@/-]|%(?:C[2-9A-F]|D[0-9A-F])%[89AB][0-9A-F]|%E0%[AB][0-9A-F]%[89AB][0-9A-F]|%E(?:[1-C]|[E-F])%[89AB][0-9A-F]%[89AB][0-9A-F]|%ED%[89][0-9A-F]%[89AB][0-9A-F]|%F0%[9AB][0-9A-F]%[89AB][0-9A-F]%[89AB][0-9A-F]|%F[1-3]%[89AB][0-9A-F]%[89AB][0-9A-F]%[89AB][0-9A-F]|%F4%8[0-9A-F]%[89AB][0-9A-F]%[89AB][0-9A-F])+)#(?=[^#]{1,2048}$)(?!.*\\s)(?!.*[\\uD800-\\uDFFF])(?:[A-Za-z0-9._~!$&'()*+,;=:@/?-]|%[0-9A-Fa-f]{2}|[^\\u0000-\\u007F])+$",
      "description": "An anchored href with a canonical serialized route of at most 2048 characters and the existing URL fragment grammar of at most 2048 characters."
    },
    "absoluteHttpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://(?![^/?#]*@)"
    },
    "resolvedHref": {
      "oneOf": [
        {
          "$ref": "#/$defs/routePath"
        },
        {
          "$ref": "#/$defs/originRelativeAnchoredHref"
        },
        {
          "$ref": "#/$defs/absoluteHttpUrl"
        }
      ]
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "url": {
          "$ref": "#/$defs/absoluteHttpUrl"
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placement",
        "copyright",
        "text",
        "url",
        "sourceCodeUrl"
      ],
      "properties": {
        "placement": {
          "const": "footer"
        },
        "copyright": {
          "const": "Copyright 2026 GENII Foundation"
        },
        "text": {
          "const": "Published with GENII Publisher"
        },
        "url": {
          "const": "https://publisher.genii.foundation"
        },
        "sourceCodeUrl": {
          "$ref": "#/$defs/absoluteHttpUrl"
        }
      }
    },
    "contentSourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "publicationId",
        "engineVersion",
        "compilerVersion",
        "buildId",
        "contentHash"
      ],
      "properties": {
        "kind": {
          "const": "publication-content"
        },
        "schemaVersion": {
          "const": "1.0"
        },
        "publicationId": {
          "$ref": "#/$defs/stableId"
        },
        "engineVersion": {
          "$ref": "#/$defs/exactSemver"
        },
        "compilerVersion": {
          "$ref": "#/$defs/exactSemver"
        },
        "buildId": {
          "$ref": "#/$defs/sha256Digest"
        },
        "contentHash": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mediaType",
        "relativePath"
      ],
      "properties": {
        "kind": {
          "const": "publication-reader"
        },
        "mediaType": {
          "const": "application/vnd.genii.publisher.reader+json"
        },
        "relativePath": {
          "const": "reader/publication-reader.json"
        }
      }
    },
    "textProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "representation",
        "normalization",
        "offsetUnit",
        "rangeScope",
        "endBoundary"
      ],
      "properties": {
        "id": {
          "const": "genii-reader-block-markdown"
        },
        "version": {
          "const": "1.0"
        },
        "representation": {
          "const": "markdown"
        },
        "normalization": {
          "const": "none"
        },
        "offsetUnit": {
          "const": "utf-16-code-unit"
        },
        "rangeScope": {
          "const": "block"
        },
        "endBoundary": {
          "const": "exclusive"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "language",
        "publisher",
        "attribution"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "canonicalUrl": {
          "$ref": "#/$defs/absoluteHttpUrl"
        },
        "publisher": {
          "$ref": "#/$defs/publisher"
        },
        "attribution": {
          "$ref": "#/$defs/attribution"
        }
      }
    },
    "contentContinuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "legacyIds",
        "progressGroups",
        "historicalSectionIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contentId"
        },
        "legacyIds": {
          "type": "array",
          "maxItems": 200000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentId"
          }
        },
        "progressGroups": {
          "type": "array",
          "maxItems": 200000,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200000,
            "items": {
              "$ref": "#/$defs/contentId"
            }
          }
        },
        "historicalSectionIds": {
          "type": "array",
          "maxItems": 200000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentId"
          }
        }
      }
    },
    "nullableContentId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/contentId"
        }
      ]
    },
    "nullableSectionReaderAddress": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sectionReaderAddress"
        }
      ]
    },
    "nullableBlockReaderAddress": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/blockReaderAddress"
        }
      ]
    },
    "nullableBlockDomId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/blockDomId"
        }
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "markdown",
        "text",
        "readerAddress",
        "domId",
        "wordCount",
        "contentHash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contentId"
        },
        "kind": {
          "$ref": "#/$defs/stableId"
        },
        "markdown": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "readerAddress": {
          "$ref": "#/$defs/nullableBlockReaderAddress"
        },
        "domId": {
          "$ref": "#/$defs/nullableBlockDomId"
        },
        "wordCount": {
          "type": "integer",
          "minimum": 0
        },
        "contentHash": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "title",
        "parentId",
        "childIds",
        "depth",
        "order",
        "routes",
        "activeRouteNames",
        "readerAddress",
        "domId",
        "continuity",
        "navigable",
        "blocks",
        "previousId",
        "nextId",
        "wordCount",
        "readingMinutes",
        "contentHash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contentId"
        },
        "role": {
          "$ref": "#/$defs/stableId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "parentId": {
          "$ref": "#/$defs/nullableContentId"
        },
        "childIds": {
          "type": "array",
          "maxItems": 200000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentId"
          }
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "routes": {
          "type": "object",
          "maxProperties": 100000,
          "propertyNames": {
            "$ref": "#/$defs/stableId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/contentAddress"
          }
        },
        "activeRouteNames": {
          "type": "array",
          "maxItems": 200000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "readerAddress": {
          "$ref": "#/$defs/nullableSectionReaderAddress"
        },
        "domId": {
          "$ref": "#/$defs/nullableContentId"
        },
        "continuity": {
          "$ref": "#/$defs/contentContinuity"
        },
        "navigable": {
          "type": "boolean"
        },
        "blocks": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "previousId": {
          "$ref": "#/$defs/nullableContentId"
        },
        "nextId": {
          "$ref": "#/$defs/nullableContentId"
        },
        "wordCount": {
          "type": "integer",
          "minimum": 0
        },
        "readingMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "contentHash": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "language",
        "publicationState",
        "route",
        "rootSectionIds",
        "sections",
        "wordCount",
        "readingMinutes",
        "contentHash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "subtitle": {
          "type": "string",
          "maxLength": 512
        },
        "summary": {
          "type": "string",
          "maxLength": 4096
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "publicationState": {
          "enum": [
            "archived",
            "draft",
            "published",
            "unlisted"
          ]
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "route": {
          "$ref": "#/$defs/routePath"
        },
        "rootSectionIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentId"
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "wordCount": {
          "type": "integer",
          "minimum": 0
        },
        "readingMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "contentHash": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "publicationState",
        "route",
        "workIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "publicationState": {
          "enum": [
            "archived",
            "draft",
            "published",
            "unlisted"
          ]
        },
        "route": {
          "$ref": "#/$defs/routePath"
        },
        "workIds": {
          "type": "array",
          "maxItems": 4999,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "routeTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "home"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "viewId"
          ],
          "properties": {
            "kind": {
              "const": "updates"
            },
            "viewId": {
              "$ref": "#/$defs/stableId"
            },
            "pagination": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "pageSize"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 2048
                },
                "pageSize": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "workId"
          ],
          "properties": {
            "kind": {
              "const": "work"
            },
            "workId": {
              "$ref": "#/$defs/stableId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "collectionId"
          ],
          "properties": {
            "kind": {
              "const": "collection"
            },
            "collectionId": {
              "$ref": "#/$defs/stableId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "workId",
            "sectionId",
            "routeName"
          ],
          "properties": {
            "kind": {
              "const": "section"
            },
            "workId": {
              "$ref": "#/$defs/stableId"
            },
            "sectionId": {
              "$ref": "#/$defs/contentId"
            },
            "routeName": {
              "$ref": "#/$defs/stableId"
            }
          }
        }
      ]
    },
    "activeRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "target"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/routePath"
        },
        "target": {
          "$ref": "#/$defs/routeTarget"
        }
      }
    },
    "redirect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "status"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/routePath"
        },
        "to": {
          "$ref": "#/$defs/resolvedHref"
        },
        "status": {
          "enum": [
            301,
            302,
            307,
            308
          ]
        }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "redirects"
      ],
      "properties": {
        "active": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/activeRoute"
          }
        },
        "redirects": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/redirect"
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "href",
        "mediaType",
        "hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "workId": {
          "$ref": "#/$defs/stableId"
        },
        "href": {
          "$ref": "#/$defs/routePath"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "hash": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "blockMarkdownRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "linkLocation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "workId",
            "sectionId"
          ],
          "properties": {
            "kind": {
              "const": "semantic"
            },
            "workId": {
              "$ref": "#/$defs/stableId"
            },
            "sectionId": {
              "$ref": "#/$defs/contentId"
            },
            "blockId": {
              "$ref": "#/$defs/contentId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "workId",
            "sectionId",
            "blockId",
            "range"
          ],
          "properties": {
            "kind": {
              "const": "block-markdown"
            },
            "workId": {
              "$ref": "#/$defs/stableId"
            },
            "sectionId": {
              "$ref": "#/$defs/contentId"
            },
            "blockId": {
              "$ref": "#/$defs/contentId"
            },
            "range": {
              "$ref": "#/$defs/blockMarkdownRange"
            }
          }
        }
      ]
    },
    "linkTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "assetId"
          ],
          "properties": {
            "kind": {
              "const": "asset"
            },
            "assetId": {
              "$ref": "#/$defs/stableId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "collectionId"
          ],
          "properties": {
            "kind": {
              "const": "collection"
            },
            "collectionId": {
              "$ref": "#/$defs/stableId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "external"
            },
            "url": {
              "$ref": "#/$defs/absoluteHttpUrl"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "workId",
            "sectionId",
            "routeName"
          ],
          "properties": {
            "kind": {
              "const": "section"
            },
            "workId": {
              "$ref": "#/$defs/stableId"
            },
            "sectionId": {
              "$ref": "#/$defs/contentId"
            },
            "routeName": {
              "$ref": "#/$defs/stableId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "workId"
          ],
          "properties": {
            "kind": {
              "const": "work"
            },
            "workId": {
              "$ref": "#/$defs/stableId"
            }
          }
        }
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "href"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "source": {
          "$ref": "#/$defs/linkLocation"
        },
        "target": {
          "$ref": "#/$defs/linkTarget"
        },
        "href": {
          "$ref": "#/$defs/resolvedHref"
        },
        "label": {
          "type": "string",
          "maxLength": 1024
        },
        "relation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workCount",
        "collectionCount",
        "sectionCount",
        "blockCount",
        "wordCount",
        "readingMinutes",
        "wordsPerMinute"
      ],
      "properties": {
        "workCount": {
          "type": "integer",
          "minimum": 0
        },
        "collectionCount": {
          "type": "integer",
          "minimum": 0
        },
        "sectionCount": {
          "type": "integer",
          "minimum": 0
        },
        "blockCount": {
          "type": "integer",
          "minimum": 0
        },
        "wordCount": {
          "type": "integer",
          "minimum": 0
        },
        "readingMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "wordsPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      }
    }
  }
}
