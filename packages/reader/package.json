{
  "name": "@genii-foundation/publisher-reader",
  "version": "0.1.0-alpha.0",
  "description": "Framework-neutral reader projection and runtime for GENII Publisher.",
  "license": "CPAL-1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25 || >=26.0.0 <27"
  },
  "bundleDependencies": [
    "mdast-util-from-markdown"
  ],
  "files": [
    "CHANGES.md",
    "LEGAL",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "SOURCE-NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "scripts",
    "src",
    "third-party-licenses",
    "tsconfig.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./preferences": {
      "types": "./dist/preferences.d.ts",
      "import": "./dist/preferences.js"
    },
    "./progress": {
      "types": "./dist/progress.d.ts",
      "import": "./dist/progress.js"
    },
    "./progress-overview": {
      "types": "./dist/progress-overview.d.ts",
      "import": "./dist/progress-overview.js"
    },
    "./passage-range": {
      "types": "./dist/passage-range.d.ts",
      "import": "./dist/passage-range.js"
    },
    "./bookmarks": {
      "types": "./dist/bookmarks.d.ts",
      "import": "./dist/bookmarks.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "import": "./dist/sync.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ./scripts/build.mjs && node ./scripts/bundle-dependencies.mjs stage",
    "postpack": "node ./scripts/bundle-dependencies.mjs clean",
    "prepublishOnly": "node ../../provenance/scripts/reject-directory-publish.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genii-foundation/publisher.git",
    "directory": "packages/reader"
  },
  "homepage": "https://publisher.genii.foundation",
  "bugs": {
    "url": "https://github.com/genii-foundation/publisher/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@genii-foundation/publisher-content": "0.1.0-alpha.0",
    "@genii-foundation/publisher-schema": "0.1.0-alpha.0",
    "mdast-util-from-markdown": "2.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.27.0",
    "semver": "7.8.5",
    "typescript": "7.0.2"
  }
}
