{
  "name": "@genii-foundation/publisher-reader",
  "version": "0.1.0-alpha.0",
  "description": "Framework-neutral reader projection and runtime for GENII Publisher.",
  "license": "CPAL-1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25 || >=26.0.0 <27"
  },
  "files": [
    "CHANGES.md",
    "LEGAL",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "SOURCE-NOTICE",
    "dist",
    "scripts",
    "src",
    "tsconfig.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ./scripts/build.mjs",
    "prepublishOnly": "node ./scripts/check-release-tag.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genii-foundation/publisher.git",
    "directory": "packages/reader"
  },
  "homepage": "https://publisher.genii.foundation",
  "bugs": {
    "url": "https://github.com/genii-foundation/publisher/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@genii-foundation/publisher-content": "0.1.0-alpha.0",
    "@genii-foundation/publisher-schema": "0.1.0-alpha.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.27.0",
    "semver": "7.8.5",
    "typescript": "7.0.2"
  }
}
