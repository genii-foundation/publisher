{
  "name": "@genii-foundation/publisher-content",
  "version": "0.1.0-alpha.0",
  "description": "Framework-neutral content compilation primitives for GENII Publisher.",
  "license": "CPAL-1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25 || >=26.0.0 <27"
  },
  "bundleDependencies": [
    "@unicode/unicode-15.1.0",
    "mdast-util-from-markdown",
    "mdast-util-to-string"
  ],
  "files": [
    "CHANGES.md",
    "LEGAL",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "SOURCE-NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "scripts",
    "src",
    "third-party-licenses",
    "tsconfig.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs && node ./scripts/bundle-runtime.mjs freeze",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build && node ./scripts/bundle-runtime.mjs stage",
    "postpack": "node ./scripts/bundle-runtime.mjs clean",
    "prepublishOnly": "node ./scripts/check-release-tag.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genii-foundation/publisher.git",
    "directory": "packages/content"
  },
  "homepage": "https://publisher.genii.foundation",
  "bugs": {
    "url": "https://github.com/genii-foundation/publisher/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@genii-foundation/publisher-schema": "0.1.0-alpha.0",
    "@unicode/unicode-15.1.0": "1.6.17",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-to-string": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.27.0",
    "semver": "7.8.5",
    "typescript": "7.0.2"
  }
}
