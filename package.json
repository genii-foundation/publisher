{
  "name": "@genii-foundation/publisher-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "The GENII Publisher open source publishing application workspace.",
  "license": "CPAL-1.0",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25 || >=26.0.0 <27",
    "npm": "10.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "schemas"
  ],
  "scripts": {
    "build": "node schemas/scripts/build.mjs && node packages/content/scripts/build.mjs",
    "test": "node schemas/scripts/build.mjs && node packages/content/scripts/build.mjs && node --test",
    "validate": "node schemas/scripts/build.mjs && node packages/content/scripts/build.mjs && node --test"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
